---
// Single reusable modal. Populated at runtime from the clicked card's
// data-* attributes (see the inline script in /projects).
---
<div class="modal-overlay" id="projectModal" aria-hidden="true">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <button type="button" class="modal-close" id="modalClose" aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="modal-media">
      <img id="modalImage" src="" alt="" />
    </div>

    <div class="modal-thumbs" id="modalThumbs" hidden></div>

    <div class="modal-body">
      <h2 class="modal-title" id="modalTitle"></h2>
      <p class="modal-summary" id="modalSummary"></p>
      <ul class="modal-tech" id="modalTech"></ul>
      <a class="modal-cta" id="modalCta" href="#"></a>
    </div>
  </div>
</div>
