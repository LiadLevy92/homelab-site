---
// Second Brain — Landing Page & Waitlist
const canonicalURL = 'https://liad-dev.com/second-brain';
const title = 'Second Brain — הצטרפו לוויטליסט';
const description = 'Second Brain — המוח השני שלך בטלגרם. שלח תמונה, קול, או טקסט — הבוט מתייק ל-Notion אוטומטית עם AI. שמור הכל, מצא הכל.';
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Liad Levy" />
  <meta name="keywords" content="Second Brain, בוט טלגרם, Notion, AI, PKM, ניהול ידע, בוט, אוטומציה, ליעד לוי" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Liad Levy" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:image" content="https://liad-dev.com/og/brain.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Second Brain — המוח השני שלך בטלגרם" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://liad-dev.com/og/brain.png" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Rubik:wght@500;600&family=Secular+One&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav class="top-nav">
    <a href="/" class="nav-back">← liad-dev.com</a>
    <div class="nav-brand">
      <span class="brand-icon">🧠</span>
      <span class="brand-name">Second Brain</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="container">
      <div class="hero-badge">🔒 בטא פרטית (למוזמנים בלבד)</div>
      <h1 class="hero-title">
        הבלגן הדיגיטלי שלכם.<br>
        <span class="gradient-text">מסודר. בטלגרם.</span>
      </h1>
      <p class="hero-sub">
        זרקו לבוט ה-AI שלכם קישורים, צילומי מסך או הקלטות קוליות שאתם מפחדים לשכוח.<br>
        הוא כבר יתמלל, יסכם ויארגן הכל בדשבורד אישי ונקי משלכם.
      </p>
      <a href="#waitlist" class="btn-primary">הצטרפו לוויטליסט ←</a>
    </div>
  </section>

  <!-- TELEGRAM DEMO -->
  <section class="section demo-section">
    <div class="container">
      <p class="section-label">ראו איך זה עובד</p>
      <div class="demo-outer">
        <div class="tg-phone" id="tgPhone">
          <div class="tg-window" dir="ltr">
            <div class="tg-header">
              <div class="tg-hdr-left">
                <div class="tg-avatar">🧠</div>
                <div class="tg-hdr-info">
                  <div class="tg-hdr-name">Your Second Brain Bot</div>
                  <div class="tg-hdr-status"><span class="tg-online-dot"></span>online</div>
                </div>
              </div>
              <div class="tg-hdr-dots">⋮</div>
            </div>
            <div class="tg-msgs" id="tgMsgs"></div>
            <div class="tg-input-bar">
              <div class="tg-input-wrap">
                <span class="tg-emoji-btn">😊</span>
                <div class="tg-input-field" id="tgInputField">
                  <span id="tgTypingText"></span><span class="tg-blink" id="tgBlink" style="display:none">|</span>
                </div>
              </div>
              <button class="tg-send-btn" id="tgSendBtn" aria-label="Send">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SCENARIOS -->
  <section class="section">
    <div class="container">
      <p class="section-label">מכירים את זה?</p>
      <div class="scenario-grid">

        <div class="scenario-card">
          <span class="scenario-emoji">🔗</span>
          <p class="problem-text">שלחתי לעצמי לינק בוואטסאפ.<br><span class="punch">בהצלחה למצוא אותו עכשיו.</span></p>
          <div class="solution-chip">פשוט שלחו לבוט 🤖</div>
        </div>

        <div class="scenario-card">
          <span class="scenario-emoji">📸</span>
          <p class="problem-text">מאות צילומי מסך בגלריה.<br><span class="punch">ואפס דרך למצוא את הנכון.</span></p>
          <div class="solution-chip">פשוט שלחו לבוט 🤖</div>
        </div>

        <div class="scenario-card">
          <span class="scenario-emoji">🎙️</span>
          <p class="problem-text">רעיון גאוני באמצע נסיעה.<br><span class="punch">נשכח עד שהגעת הביתה.</span></p>
          <div class="solution-chip">פשוט שלחו לבוט 🤖</div>
        </div>

      </div>
    </div>
  </section>

  <!-- WAITLIST FORM -->
  <section class="section form-section" id="waitlist">
    <div class="container">
      <div class="form-card">
        <div class="form-header">
          <span class="form-badge">🧠 הצטרפו לוויטליסט</span>
          <h2 class="form-title">תפסו מקום ברשימת ההמתנה ⏳</h2>
          <p class="form-subtitle">המקומות מוגבלים בשלב זה כדי לשמור על יציבות השרת וביצועי ה-AI.</p>
        </div>

        <form id="waitlistForm" class="signup-form">
          <div class="field-group">
            <label for="wl-name">שם מלא</label>
            <input type="text" id="wl-name" name="name" placeholder="ישראל ישראלי" autocomplete="name" required />
          </div>
          <div class="field-group">
            <label for="wl-email">כתובת אימייל</label>
            <input type="email" id="wl-email" name="email" placeholder="you@example.com" dir="ltr" autocomplete="email" required />
          </div>
          <!-- honeypot — hidden from humans, bots fill it -->
          <div class="hp-field" aria-hidden="true">
            <label for="wl-company">Company (leave empty)</label>
            <input type="text" id="wl-company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <button type="submit" id="submitBtn" class="btn-submit">
            <span id="btnText">שמרו לי מקום ←</span>
            <span id="btnLoading" style="display:none">שולח…</span>
          </button>
          <p class="form-fine-print">* הגרסה החינמית מוגבלת ל-10 הודעות בחודש, או בחיבור מפתח API אישי שלך.</p>
        </form>

        <div id="msg-success" class="feedback-msg success" style="display:none">
          ✅ נרשמת! שלחנו התראה לליעד והוא יאשר אותך בקרוב. 🔒
        </div>
        <div id="msg-duplicate" class="feedback-msg info" style="display:none">
          😉 האימייל הזה כבר רשום ברשימת ההמתנה!
        </div>
        <div id="msg-error" class="feedback-msg error" style="display:none">
          משהו השתבש. נסו שוב עוד כמה שניות.
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="page-footer">
    <a href="/" class="footer-link">← חזרה ל-liad-dev.com</a>
    <span class="footer-copy">Second Brain · Israel · נבנה עם Claude Code</span>
  </footer>

  <script is:inline>
    const SUPABASE_URL = 'https://xntytizwljdlblyusfpo.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhudHl0aXp3bGpkbGJseXVzZnBvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNTEwMTcsImV4cCI6MjA5NDYyNzAxN30.zoavGpETyQ0aCodsSk3YY9V0hkYMrsKkCgPkaAAYvas';

    const form = document.getElementById('waitlistForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnLoading = document.getElementById('btnLoading');
    const formLoadTime = Date.now();

    function showMsg(id) {
      ['msg-success', 'msg-duplicate', 'msg-error'].forEach(m => {
        document.getElementById(m).style.display = 'none';
      });
      if (id) document.getElementById(id).style.display = 'block';
    }

    function setLoading(on) {
      submitBtn.disabled = on;
      btnText.style.display = on ? 'none' : 'inline';
      btnLoading.style.display = on ? 'inline' : 'none';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name  = document.getElementById('wl-name').value.trim();
      const email = document.getElementById('wl-email').value.trim().toLowerCase();
      if (!name || !email) return;

      // Spam guard — honeypot filled OR submitted suspiciously fast → fake success, no insert
      const hp = document.getElementById('wl-company').value;
      if (hp || (Date.now() - formLoadTime) < 2500) {
        form.style.display = 'none';
        showMsg('msg-success');
        return;
      }

      setLoading(true);
      showMsg(null);

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/waiting_list`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({ name, email })
        });

        setLoading(false);

        if (res.status === 201 || res.ok) {
          form.style.display = 'none';
          showMsg('msg-success');
        } else {
          const err = await res.json().catch(() => ({}));
          showMsg(err.code === '23505' ? 'msg-duplicate' : 'msg-error');
        }
      } catch (_) {
        setLoading(false);
        showMsg('msg-error');
      }
    });
  </script>

  <script is:inline>
  (function() {
    var scenarios = [
      {
        userText: 'לזכור לסדר לאישה את המדפים במטבח',
        isVoice: false,
        analysisTitle: '🧠 ניתוח קלוד: משימות',
        analysisSub: '🔦 זיהיתי תזכורת אישית',
        bullets: ['לסדר את המדפים במטבח', 'לתאם עם האישה מתי מתאים', 'ניתן לדחות לסוף שבוע'],
        tags: ['✅ Task', '🏠 Home'],
        priority: 'עדיפות: Low 🔥',
        saved: '✅ נשמר\n🏠 משימה: לסדר מדפים במטבח'
      },
      {
        userText: 'https://youtu.be/xvFZjo5PgG0',
        isVoice: false,
        analysisTitle: '🧠 ניתוח קלוד: תוכן',
        analysisSub: '🔦 זיהיתי סרטון מתכון',
        bullets: ['פסטה עם עגבניות שרי וגבינה צהובה', 'זמן הכנה: 20 דקות', 'מתאים לילדים'],
        tags: ['🍝 Recipe', '📁 אוכל'],
        priority: 'עדיפות: Medium 🔥',
        saved: '✅ נשמר\n🍝 מתכון: פסטה עם עגבניות שרי'
      },
      {
        userText: null,
        isVoice: true,
        analysisTitle: '🧠 ניתוח קלוד: משימות',
        analysisSub: '🎙 "לשלוח הצעת מחיר ללקוח עד יום ראשון"',
        bullets: ['לשלוח הצעת מחיר ללקוח', 'דדליין: יום ראשון', 'סוג: משימה עם מועד'],
        tags: ['✅ Task', '📁 Work'],
        priority: 'עדיפות: High 🔥',
        saved: '✅ נשמר\n✅ משימה: הצעת מחיר ללקוח'
      }
    ];

    var idx = 0, running = false;

    function wait(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }

    /* Demo times — afternoon hours so the chat looks realistic */
    var DEMO_TIMES = [16*60+28, 14*60+52, 11*60+07]; /* 16:28, 14:52, 11:07 */
    function demoTime(scenarioIdx, offsetMins) {
      var t = DEMO_TIMES[scenarioIdx % DEMO_TIMES.length] + (offsetMins || 0);
      var h = Math.floor(t / 60) % 24;
      var m = t % 60;
      return ('0'+h).slice(-2) + ':' + ('0'+m).slice(-2);
    }

    function scrollBottom() {
      var el = document.getElementById('tgMsgs');
      if (el) el.scrollTop = el.scrollHeight;
    }

    async function typeIn(text, speed) {
      var el = document.getElementById('tgTypingText');
      var blink = document.getElementById('tgBlink');
      if (!el) return;
      if (blink) blink.style.display = 'inline';
      for (var i = 0; i <= text.length; i++) {
        el.textContent = text.slice(0, i);
        await wait(speed);
      }
    }

    function clearIn() {
      var el = document.getElementById('tgTypingText');
      var blink = document.getElementById('tgBlink');
      if (el) el.textContent = '';
      if (blink) blink.style.display = 'none';
    }

    function appendMsg(html, cls) {
      var msgs = document.getElementById('tgMsgs');
      if (!msgs) return null;
      var div = document.createElement('div');
      div.className = 'tg-msg ' + cls;
      div.innerHTML = html;
      msgs.appendChild(div);
      void div.getBoundingClientRect(); /* force reflow so opacity:0 is rendered first */
      div.classList.add('show');
      scrollBottom();
      return div;
    }

    async function playScenario(s) {
      var sendBtn = document.getElementById('tgSendBtn');
      var inputField = document.getElementById('tgInputField');

      // 1. Type or show mic recording
      if (s.isVoice) {
        var el = document.getElementById('tgTypingText');
        if (el) el.textContent = '🎤 מקליט...';
        await wait(1100);
      } else {
        var isUrl = s.userText.startsWith('http');
        if (inputField) inputField.dir = isUrl ? 'ltr' : 'rtl';
        await typeIn(s.userText, 42);
        await wait(450); /* pause after typing before sending */
      }

      // 2. Send button press animation
      if (sendBtn) {
        sendBtn.style.transform = 'scale(0.82)';
        await wait(120);
        sendBtn.style.transform = 'scale(1)';
      }
      clearIn();
      if (inputField) inputField.dir = 'rtl';

      // User bubble
      var userHtml;
      if (s.isVoice) {
        userHtml = '<div class="tg-vbubble">'
          + '<span class="tg-vicon">🎤</span>'
          + '<div class="tg-vwave"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>'
          + '<span class="tg-vdur">0:08</span>'
          + '</div><div class="tg-time">' + demoTime(idx, 0) + ' ✓✓</div>';
      } else {
        var udir = s.userText.startsWith('http') ? 'ltr' : 'rtl';
        var utxt = s.userText.startsWith('http')
          ? '<span style="direction:ltr;display:block;text-align:left">' + s.userText + '</span>'
          : s.userText;
        userHtml = utxt + '<div class="tg-time">' + demoTime(idx, 0) + ' ✓✓</div>';
      }
      appendMsg(userHtml, 'tg-msg-user');
      await wait(500); /* pause before מנתח appears */

      // 3. "מנתח..." message — matches real bot behavior, clearly visible
      var typing = appendMsg('🤔 מנתח...', 'tg-msg-bot');
      await wait(2500);
      if (typing && typing.parentNode) typing.parentNode.removeChild(typing);
      await wait(120);

      // 4. Analysis card appears
      var bulletsHtml = s.bullets.map(function(b) { return '<div class="tg-bul">' + b + '</div>'; }).join('');
      var tagsHtml = s.tags.map(function(t) { return '<span class="tg-tag">' + t + '</span>'; }).join('');
      var cardHtml = [
        '<div class="tg-an-title">' + s.analysisTitle + '</div>',
        '<div class="tg-an-sub">' + s.analysisSub + '</div>',
        bulletsHtml,
        '<div class="tg-tags-row">' + tagsHtml + '</div>',
        '<div class="tg-prio">' + s.priority + '</div>',
        '<hr class="tg-hr">',
        '<div class="tg-saveq">שומרים?</div>',
        '<div class="tg-kbd"><button class="tg-kbtn tg-cancel">❌ בטל</button><button class="tg-kbtn tg-save">✅ שמור</button></div>',
        '<div class="tg-time">' + demoTime(idx, 1) + '</div>'
      ].join('');
      var card = appendMsg(cardHtml, 'tg-msg-bot');
      if (!card) return;
      await wait(300);

      // 5. Stagger bullets one by one
      var buls = card.querySelectorAll('.tg-bul');
      for (var i = 0; i < buls.length; i++) {
        await wait(200);
        buls[i].classList.add('show');
        scrollBottom();
      }

      // 6. Reveal remaining elements
      await wait(160); card.querySelector('.tg-tags-row').classList.add('show');
      await wait(140); card.querySelector('.tg-prio').classList.add('show');
      await wait(140); card.querySelector('.tg-hr').classList.add('show');
      await wait(140); card.querySelector('.tg-saveq').classList.add('show');
      await wait(190); card.querySelector('.tg-kbd').classList.add('show');
      scrollBottom();

      // 7. Tap animation on שמור button
      await wait(1600);
      var saveBtn = card.querySelector('.tg-save');
      if (saveBtn) {
        saveBtn.classList.add('tapped');          /* green flash — clear finger press */
        await wait(500);                          /* wait for full 0.48s animation + buffer */
        saveBtn.classList.remove('tapped');
        saveBtn.classList.add('active');          /* green confirm state */
      }
      await wait(400);

      // 8. Confirmation message
      var confirmHtml = s.saved.replace('\n', '<br>') + '<div class="tg-time">' + demoTime(idx, 1) + '</div>';
      appendMsg(confirmHtml, 'tg-msg-bot tg-confirm');
      await wait(2400);

      // 9. Fade out & reset for next scenario
      var msgs = document.getElementById('tgMsgs');
      if (!msgs) return;
      msgs.style.transition = 'opacity 0.65s';
      msgs.style.opacity = '0';
      await wait(700);
      msgs.innerHTML = '';
      msgs.style.opacity = '1';
      msgs.style.transition = '';
    }

    async function loop() {
      if (running) return;
      running = true;
      while (true) {
        await playScenario(scenarios[idx]);
        idx = (idx + 1) % scenarios.length;
        await wait(350);
      }
    }

    function start() {
      var phone = document.getElementById('tgPhone');
      if (!phone) return;
      if ('IntersectionObserver' in window) {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) { loop(); obs.disconnect(); }
          });
        }, { threshold: 0.25 });
        obs.observe(phone);
      } else {
        loop();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
  </script>

</body>
</html>

<style is:global>
  :root {
    --bg:             #050511;
    --surface:        #0c0d1f;
    --surface-2:      #12132a;
    --border:         rgba(99,102,241,0.12);
    --border-bright:  rgba(99,102,241,0.28);
    --indigo:         #6366f1;
    --indigo-hi:      #818cf8;
    --indigo-low:     rgba(99,102,241,0.08);
    --indigo-glow:    rgba(99,102,241,0.28);
    --purple:         #a78bfa;
    --text:           #ededff;
    --text-dim:       #9ea3cc;
    --text-muted:     #555878;
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(99,102,241,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99,102,241,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none; z-index: 0;
  }
  body::after {
    content: '';
    position: fixed; inset: 0;
    background: radial-gradient(ellipse 80% 50% at 50% -5%, rgba(99,102,241,0.13), transparent 60%);
    pointer-events: none; z-index: 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 28px;
    position: relative; z-index: 1;
  }

  /* NAV */
  .top-nav {
    position: fixed; top: 0; inset-inline-start: 0; inset-inline-end: 0;
    z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 32px;
    background: rgba(5,5,17,0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-back {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; color: var(--text-muted);
    text-decoration: none; letter-spacing: 0.5px;
    transition: color 0.2s;
  }
  .nav-back:hover { color: var(--text-dim); }
  .nav-brand { display: flex; align-items: center; gap: 8px; }
