---
// Second Brain — Landing Page & Waitlist
const canonicalURL = 'https://liad-dev.com/second-brain';
const title = 'Second Brain — הצטרפו לוויטליסט';
const description = 'Second Brain — המוח השני שלך בטלגרם. שלח תמונה, קול, או טקסט — הבוט מתייק ל-Notion אוטומטית עם AI. שמור הכל, מצא הכל.';
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Liad Levy" />
  <meta name="keywords" content="Second Brain, בוט טלגרם, Notion, AI, PKM, ניהול ידע, בוט, אוטומציה, ליעד לוי" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Liad Levy" />
  <meta property="og:locale" content="he_IL" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Rubik:wght@500;600&family=Secular+One&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav class="top-nav">
    <a href="/" class="nav-back">← liad-dev.com</a>
    <div class="nav-brand">
      <span class="brand-icon">🧠</span>
      <span class="brand-name">Second Brain</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="container">
      <div class="hero-badge">🔒 בטא פרטית (למוזמנים בלבד)</div>
      <h1 class="hero-title">
        הבלגן הדיגיטלי שלכם.<br>
        <span class="gradient-text">מסודר. בטלגרם.</span>
      </h1>
      <p class="hero-sub">
        זרקו לבוט ה-AI שלכם קישורים, צילומי מסך או הקלטות קוליות שאתם מפחדים לשכוח.<br>
        הוא כבר יתמלל, יסכם ויארגן הכל בדשבורד אישי ונקי משלכם.
      </p>
      <a href="#waitlist" class="btn-primary">הצטרפו לוויטליסט ←</a>
    </div>
  </section>

  <!-- SCENARIOS -->
  <section class="section">
    <div class="container">
      <p class="section-label">מכירים את זה?</p>
      <div class="scenario-grid">

        <div class="scenario-card">
          <div class="scenario-top">
            <p class="problem-text">"אני יודע בוודאות ששלחתי לעצמי בוואטסאפ את הלינק ההוא… איפה הוא עכשיו?!"</p>
          </div>
          <div class="solution-block">
            <span class="solution-label">הפתרון ב-Second Brain:</span>
            <p class="solution-text">זורקים את הלינק לבוט בטלגרם. הוא שואב את התוכן של האתר, מסכם אותו ומקטלג אוטומטית במקום הנכון.</p>
          </div>
        </div>

        <div class="scenario-card">
          <div class="scenario-top">
            <p class="problem-text">טובעים בים של מאות צילומי מסך בגלריה, שאף אחד מהם לא ניתן לחיפוש.</p>
          </div>
          <div class="solution-block">
            <span class="solution-label">הפתרון ב-Second Brain:</span>
            <p class="solution-text">משתפים את התמונה עם הבוט. ה-AI מנתח את מה שרואים בצילום המסך ומהפך אותו לטקסט חי שניתן למצוא בשנייה.</p>
          </div>
        </div>

        <div class="scenario-card">
          <div class="scenario-top">
            <p class="problem-text">רעיונות מטורפים שעולים תוך כדי נסיעה, ומסתיימים בהקלטה ארוכה שנשכחת.</p>
          </div>
          <div class="solution-block">
            <span class="solution-label">הפתרון ב-Second Brain:</span>
            <p class="solution-text">מקליטים הודעה קולית חופשית לבוט. המערכת מתמללת, מזקקת את התובנות ושולחת משימות ישירות לדשבורד.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- WAITLIST FORM -->
  <section class="section form-section" id="waitlist">
    <div class="container">
      <div class="form-card">
        <div class="form-header">
          <span class="form-badge">🧠 הצטרפו לוויטליסט</span>
          <h2 class="form-title">תפסו מקום ברשימת ההמתנה ⏳</h2>
          <p class="form-subtitle">המקומות מוגבלים בשלב זה כדי לשמור על יציבות השרת וביצועי ה-AI.</p>
        </div>

        <form id="waitlistForm" class="signup-form">
          <div class="field-group">
            <label for="wl-name">שם מלא</label>
            <input type="text" id="wl-name" name="name" placeholder="ישראל ישראלי" autocomplete="name" required />
          </div>
          <div class="field-group">
            <label for="wl-email">כתובת אימייל</label>
            <input type="email" id="wl-email" name="email" placeholder="you@example.com" dir="ltr" autocomplete="email" required />
          </div>
          <button type="submit" id="submitBtn" class="btn-submit">
            <span id="btnText">שמרו לי מקום ←</span>
            <span id="btnLoading" style="display:none">שולח…</span>
          </button>
          <p class="form-fine-print">* הגרסה החינמית מוגבלת ל-10 הודעות בחודש, או בחיבור מפתח API אישי שלך.</p>
        </form>

        <div id="msg-success" class="feedback-msg success" style="display:none">
          ✅ נרשמת! שלחנו התראה לליעד והוא יאשר אותך בקרוב. 🔒
        </div>
        <div id="msg-duplicate" class="feedback-msg info" style="display:none">
          😉 האימייל הזה כבר רשום ברשימת ההמתנה!
        </div>
        <div id="msg-error" class="feedback-msg error" style="display:none">
          משהו השתבש. נסו שוב עוד כמה שניות.
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="page-footer">
    <a href="/" class="footer-link">← חזרה ל-liad-dev.com</a>
    <span class="footer-copy">Second Brain · Israel · נבנה עם Claude Code</span>
  </footer>

  <script is:inline>
    const SUPABASE_URL = 'https://xntytizwljdlblyusfpo.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhudHl0aXp3bGpkbGJseXVzZnBvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNTEwMTcsImV4cCI6MjA5NDYyNzAxN30.zoavGpETyQ0aCodsSk3YY9V0hkYMrsKkCgPkaAAYvas';

    const form = document.getElementById('waitlistForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnLoading = document.getElementById('btnLoading');

    function showMsg(id) {
      ['msg-success', 'msg-duplicate', 'msg-error'].forEach(m => {
        document.getElementById(m).style.display = 'none';
      });
      if (id) document.getElementById(id).style.display = 'block';
    }

    function setLoading(on) {
      submitBtn.disabled = on;
      btnText.style.display = on ? 'none' : 'inline';
      btnLoading.style.display = on ? 'inline' : 'none';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name  = document.getElementById('wl-name').value.trim();
      const email = document.getElementById('wl-email').value.trim().toLowerCase();
      if (!name || !email) return;

      setLoading(true);
      showMsg(null);

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/waiting_list`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({ name, email })
        });

        setLoading(false);

        if (res.status === 201 || res.ok) {
          form.style.display = 'none';
          showMsg('msg-success');
        } else {
          const err = await res.json().catch(() => ({}));
          showMsg(err.code === '23505' ? 'msg-duplicate' : 'msg-error');
        }
      } catch (_) {
        setLoading(false);
        showMsg('msg-error');
      }
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg:             #050511;
    --surface:        #0c0d1f;
    --surface-2:      #12132a;
    --border:         rgba(99,102,241,0.12);
    --border-bright:  rgba(99,102,241,0.28);
    --indigo:         #6366f1;
    --indigo-hi:      #818cf8;
    --indigo-low:     rgba(99,102,241,0.08);
    --indigo-glow:    rgba(99,102,241,0.28);
    --purple:         #a78bfa;
    --text:           #ededff;
    --text-dim:       #9ea3cc;
    --text-muted:     #555878;
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(99,102,241,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99,102,241,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none; z-index: 0;
  }
  body::after {
    content: '';
    position: fixed; inset: 0;
    background: radial-gradient(ellipse 80% 50% at 50% -5%, rgba(99,102,241,0.13), transparent 60%);
    pointer-events: none; z-index: 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 28px;
    position: relative; z-index: 1;
  }

  /* NAV */
  .top-nav {
    position: fixed; top: 0; inset-inline-start: 0; inset-inline-end: 0;
    z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 32px;
    background: rgba(5,5,17,0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-back {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; color: var(--text-muted);
    text-decoration: none; letter-spacing: 0.5px;
    transition: color 0.2s;
  }
  .nav-back:hover { color: var(--text-dim); }
  .nav-brand { display: flex; align-items: center; gap: 8px; }
  .brand-icon { font-size: 18px; }
  .brand-name { font-weight: 600; font-size: 15px; color: var(--text); }

  /* HERO */
  .hero {
    position: relative;
    padding: 148px 0 96px;
    text-align: center;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
    width: 720px; height: 620px;
    background: radial-gradient(ellipse at center, rgba(99,102,241,0.16), transparent 65%);
    pointer-events: none; z-index: 0;
  }
  .hero-badge {
    display: inline-block;
    font-family: 'Secular One', system-ui, sans-serif;
    font-size: 13px; font-weight: 400; letter-spacing: 0;
    color: var(--indigo-hi);
    background: var(--indigo-low);
    border: 1px solid var(--border-bright);
    padding: 7px 18px; border-radius: 100px;
    margin-bottom: 28px;
    position: relative; z-index: 1;
  }
  .hero-title {
    font-size: clamp(34px, 6.5vw, 76px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.5px;
    margin-bottom: 22px;
    position: relative; z-index: 1;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--indigo-hi), var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    font-size: clamp(15px, 2.2vw, 17px);
    font-weight: 300;
    color: var(--text-dim);
    max-width: 580px;
    margin: 0 auto 38px;
    line-height: 1.8;
    position: relative; z-index: 1;
  }

  /* BUTTONS */
  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    font-size: 15px; font-weight: 600;
    color: #fff;
    background: var(--indigo);
    padding: 14px 34px;
    border-radius: 4px;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 0 28px var(--indigo-glow);
    position: relative; z-index: 1;
  }
  .btn-primary:hover {
    background: var(--indigo-hi);
    transform: translateY(-2px);
    box-shadow: 0 6px 36px var(--indigo-glow);
  }

  /* SECTIONS */
  .section { padding: 84px 0; position: relative; z-index: 1; }
  .section-label {
    font-family: 'Rubik', system-ui, sans-serif;
    font-size: 15px; font-weight: 500;
    letter-spacing: 0;
    color: var(--indigo-hi);
    margin-bottom: 44px;
    text-align: center;
  }
  .section-label::after {
    content: '';
    display: block; width: 36px; height: 2px;
    background: var(--indigo);
    margin: 10px auto 0;
    border-radius: 2px;
  }

  /* SCENARIO CARDS */
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .scenario-card {
    background: rgba(12, 13, 31, 0.65);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    backdrop-filter: blur(8px);
    transition: border-color 0.2s, transform 0.2s;
  }
  .scenario-card:hover {
    border-color: rgba(99, 102, 241, 0.32);
    transform: translateY(-3px);
  }
  .scenario-top { margin-bottom: 20px; }
  .problem-text {
    font-size: 15px; font-weight: 500;
    color: var(--text);
    line-height: 1.65;
  }
  .solution-block {
    border-top: 1px solid rgba(99, 102, 241, 0.12);
    padding-top: 14px;
  }
  .solution-label {
    display: block;
    font-size: 11px; font-weight: 700;
    color: var(--indigo-hi);
    margin-bottom: 6px;
  }
  .solution-text {
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.65;
  }

  /* FORM */
  .form-section { padding-bottom: 100px; }
  .form-card {
    max-width: 500px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: 12px;
    padding: 40px 36px;
    box-shadow: 0 0 80px rgba(99,102,241,0.07), 0 0 160px rgba(99,102,241,0.03);
  }
  .form-header { text-align: center; margin-bottom: 28px; }
  .form-badge {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1px;
    color: var(--indigo-hi);
    background: var(--indigo-low);
    border: 1px solid var(--border-bright);
    padding: 5px 14px; border-radius: 100px;
    margin-bottom: 14px;
  }
  .form-title {
    font-size: 26px; font-weight: 700;
    color: var(--text); letter-spacing: -0.5px;
    margin-bottom: 8px;
  }
  .form-subtitle { font-size: 14px; color: var(--text-dim); line-height: 1.6; }

  .signup-form { display: flex; flex-direction: column; gap: 16px; }
  .field-group { display: flex; flex-direction: column; gap: 6px; }
  .field-group label { font-size: 13px; font-weight: 500; color: var(--text-dim); }
  .field-group input {
    background: rgba(5,5,17,0.8);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 14px;
    font-size: 14px;
    font-family: inherit;
    border-radius: 6px;
    outline: none;
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field-group input::placeholder { color: var(--text-muted); }
  .field-group input:focus {
    border-color: var(--indigo);
    box-shadow: 0 0 0 3px var(--indigo-low);
  }

  .btn-submit {
    width: 100%;
    background: var(--indigo);
    color: #fff;
    border: none;
    padding: 14px;
    font-size: 15px; font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 0 24px var(--indigo-glow);
    margin-top: 4px;
  }
  .btn-submit:hover:not(:disabled) {
    background: var(--indigo-hi);
    transform: translateY(-1px);
    box-shadow: 0 4px 28px var(--indigo-glow);
  }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-fine-print {
    font-size: 11.5px; color: var(--text-muted);
    line-height: 1.55; text-align: center;
  }

  .feedback-msg {
    margin-top: 20px; padding: 14px 18px;
    border-radius: 6px; font-size: 14px;
    line-height: 1.55; text-align: center;
  }
  .feedback-msg.success {
    background: rgba(16,185,129,0.08);
    border: 1px solid rgba(16,185,129,0.25);
    color: #34d399;
  }
  .feedback-msg.info {
    background: rgba(59,130,246,0.08);
    border: 1px solid rgba(59,130,246,0.25);
    color: #60a5fa;
  }
  .feedback-msg.error {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.25);
    color: #f87171;
  }

  /* FOOTER */
  .page-footer {
    padding: 24px 32px;
    border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    position: relative; z-index: 1;
  }
  .footer-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; color: var(--text-muted);
    text-decoration: none; transition: color 0.2s;
  }
  .footer-link:hover { color: var(--text-dim); }
  .footer-copy {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .scenario-grid { grid-template-columns: 1fr; }
    .form-card { padding: 28px 20px; }
    .top-nav { padding: 14px 20px; }
  }
  @media (max-width: 480px) {
    .hero { padding: 120px 0 64px; }
    .page-footer { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>
