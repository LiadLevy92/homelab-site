---
// Second Brain — Landing Page & Waitlist
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Second Brain — המוח השני שלך בטלגרם. שמור הכל, מצא הכל." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Second Brain — הצטרפו לוויטליסט</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Rubik:wght@500;600&family=Secular+One&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- NAV -->
  <nav class="top-nav">
    <a href="/" class="nav-back">← liad-dev.com</a>
    <div class="nav-brand">
      <span class="brand-icon">🧠</span>
      <span class="brand-name">Second Brain</span>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="container">
      <div class="hero-badge">🔒 בטא פרטית (למוזמנים בלבד)</div>
      <h1 class="hero-title">
        הבלגן הדיגיטלי שלכם.<br>
        <span class="gradient-text">מסודר. בטלגרם.</span>
      </h1>
      <p class="hero-sub">
        זרקו לבוט ה-AI שלכם קישורים, צילומי מסך או הקלטות קוליות שאתם מפחדים לשכוח.<br>
        הוא כבר יתמלל, יסכם ויארגן הכל בדשבורד אישי ונקי משלכם.
      </p>
      <a href="#waitlist" class="btn-primary">הצטרפו לוויטליסט ←</a>
    </div>
  </section>

  <!-- PAIN POINTS -->
  <section class="section">
    <div class="container">
      <p class="section-label">מכיר את זה?</p>
      <div class="pain-grid">
        <div class="pain-card">
          <span class="pain-icon">📥</span>
          <h3 class="pain-title">זרוק ונסע</h3>
          <p>פשוט העבירו לבוט קישורים, תמונות, או הודעות קוליות שאתם רוצים לשמור.</p>
        </div>
        <div class="pain-card">
          <span class="pain-icon">🧠</span>
          <h3 class="pain-title">ה-AI כבר יבין</h3>
          <p>המערכת מתמללת קוליות, שולפת נקודות מפתח ומקטלגת הכל לבד בשבילכם.</p>
        </div>
        <div class="pain-card">
          <span class="pain-icon">🖥️</span>
          <h3 class="pain-title">אפס חיפושים</h3>
          <p>לוח בקרה מעוצב עם חיפוש מהיר שמציג לכם הכל מסודר ובמקום אחד.</p>
        </div>
      </div>
      <p class="pain-cta"><strong>בשביל זה אנחנו פה.</strong></p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section how-section">
    <div class="container">
      <p class="section-label">איך זה עובד</p>
      <div class="steps-wrap">
        <div class="step-item">
          <div class="step-number">01</div>
          <div class="step-icon-wrap">📲</div>
          <h3 class="step-title">שלחו לבוט</h3>
          <p class="step-desc">קישור, תמונה, הקלטה קולית, טקסט — מכל מקום, בטלגרם שאתם כבר בו</p>
        </div>
        <div class="step-arrow">↓</div>
        <div class="step-item">
          <div class="step-number">02</div>
          <div class="step-icon-wrap">🤖</div>
          <h3 class="step-title">AI עובד בשבילכם</h3>
          <p class="step-desc">מסכם, מתמלל הקלטות, מזהה קישורים, מסווג לקטגוריות — אוטומטית</p>
        </div>
        <div class="step-arrow">↓</div>
        <div class="step-item">
          <div class="step-number">03</div>
          <div class="step-icon-wrap">✨</div>
          <h3 class="step-title">הכל מסודר</h3>
          <p class="step-desc">Dashboard אישי, חיפוש מהיר, קטגוריות חכמות — הכל שם כשתחפשו</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="section">
    <div class="container">
      <p class="section-label">מה תקבלו</p>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">🗂️</span>
          <h3>כל פורמט</h3>
          <p>טקסט, הקלטות קוליות, תמונות, קישורים ומסמכים — הכל נשמר ומעובד</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🏷️</span>
          <h3>ארגון חכם</h3>
          <p>AI מזהה ומסווג אוטומטית לקטגוריות — פרויקטים, לימודים, רעיונות ועוד</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🔍</span>
          <h3>חיפוש מיידי</h3>
          <p>מצאו כל פריט שנשמר תוך שניות, לפי תוכן, תגיות, תאריך או קטגוריה</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📊</span>
          <h3>Dashboard אישי</h3>
          <p>כל מה ששמרתם, ממוין ונגיש. סיכום שבועי, פידים ותצוגות מותאמות</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WAITLIST FORM -->
  <section class="section form-section" id="waitlist">
    <div class="container">
      <div class="form-card">
        <div class="form-header">
          <span class="form-badge">🧠 הצטרפו לוויטליסט</span>
          <h2 class="form-title">תפסו מקום ברשימת ההמתנה ⏳</h2>
          <p class="form-subtitle">המקומות מוגבלים בשלב זה כדי לשמור על יציבות השרת וביצועי ה-AI.</p>
        </div>

        <form id="waitlistForm" class="signup-form">
          <div class="field-group">
            <label for="wl-name">שם מלא</label>
            <input type="text" id="wl-name" name="name" placeholder="ישראל ישראלי" autocomplete="name" required />
          </div>
          <div class="field-group">
            <label for="wl-email">כתובת אימייל</label>
            <input type="email" id="wl-email" name="email" placeholder="you@example.com" dir="ltr" autocomplete="email" required />
          </div>
          <button type="submit" id="submitBtn" class="btn-submit">
            <span id="btnText">שמרו לי מקום ←</span>
            <span id="btnLoading" style="display:none">שולח…</span>
          </button>
          <p class="form-fine-print">* הגרסה החינמית מוגבלת ל-10 הודעות בחודש, או בחיבור מפתח API אישי שלך.</p>
        </form>

        <div id="msg-success" class="feedback-msg success" style="display:none">
          ✅ נרשמת! שלחנו התראה לליעד והוא יאשר אותך בקרוב. 🔒
        </div>
        <div id="msg-duplicate" class="feedback-msg info" style="display:none">
          😉 האימייל הזה כבר רשום ברשימת ההמתנה!
        </div>
        <div id="msg-error" class="feedback-msg error" style="display:none">
          משהו השתבש. נסו שוב עוד כמה שניות.
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="page-footer">
    <a href="/" class="footer-link">← חזרה ל-liad-dev.com</a>
    <span class="footer-copy">Second Brain · Israel · נבנה עם Claude Code</span>
  </footer>

  <script is:inline>
    const SUPABASE_URL = 'https://xntytizwljdlblyusfpo.supabase.co';
    const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhudHl0aXp3bGpkbGJseXVzZnBvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkwNTEwMTcsImV4cCI6MjA5NDYyNzAxN30.zoavGpETyQ0aCodsSk3YY9V0hkYMrsKkCgPkaAAYvas';

    const form = document.getElementById('waitlistForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const btnLoading = document.getElementById('btnLoading');

    function showMsg(id) {
      ['msg-success', 'msg-duplicate', 'msg-error'].forEach(m => {
        document.getElementById(m).style.display = 'none';
      });
      if (id) document.getElementById(id).style.display = 'block';
    }

    function setLoading(on) {
      submitBtn.disabled = on;
      btnText.style.display = on ? 'none' : 'inline';
      btnLoading.style.display = on ? 'inline' : 'none';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name  = document.getElementById('wl-name').value.trim();
      const email = document.getElementById('wl-email').value.trim().toLowerCase();
      if (!name || !email) return;

      setLoading(true);
      showMsg(null);

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/waiting_list`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SUPABASE_KEY,
            'Authorization': `Bearer ${SUPABASE_KEY}`,
            'Prefer': 'return=minimal'
          },
          body: JSON.stringify({ name, email })
        });

        setLoading(false);

        if (res.status === 201 || res.ok) {
          form.style.display = 'none';
          showMsg('msg-success');
        } else {
          const err = await res.json().catch(() => ({}));
          showMsg(err.code === '23505' ? 'msg-duplicate' : 'msg-error');
        }
      } catch (_) {
        setLoading(false);
        showMsg('msg-error');
      }
    });
  </script>

</body>
</html>

<style>
  :root {
    --bg:             #050511;
    --surface:        #0c0d1f;
    --surface-2:      #12132a;
    --border:         rgba(99,102,241,0.12);
    --border-bright:  rgba(99,102,241,0.28);
    --indigo:         #6366f1;
    --indigo-hi:      #818cf8;
    --indigo-low:     rgba(99,102,241,0.08);
    --indigo-glow:    rgba(99,102,241,0.28);
    --purple:         #a78bfa;
    --text:           #ededff;
    --text-dim:       #9ea3cc;
    --text-muted:     #555878;
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
      linear-gradient(rgba(99,102,241,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99,102,241,0.03) 1px, transparent 1px);
    background-size: 44px 44px;
    pointer-events: none; z-index: 0;
  }
  body::after {
    content: '';
    position: fixed; inset: 0;
    background: radial-gradient(ellipse 80% 50% at 50% -5%, rgba(99,102,241,0.13), transparent 60%);
    pointer-events: none; z-index: 0;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 28px;
    position: relative; z-index: 1;
  }

  /* NAV */
  .top-nav {
    position: fixed; top: 0; inset-inline-start: 0; inset-inline-end: 0;
    z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 32px;
    background: rgba(5,5,17,0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .nav-back {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px; color: var(--text-muted);
    text-decoration: none; letter-spacing: 0.5px;
    transition: color 0.2s;
  }
  .nav-back:hover { color: var(--text-dim); }
  .nav-brand { display: flex; align-items: center; gap: 8px; }
  .brand-icon { font-size: 18px; }
  .brand-name { font-weight: 600; font-size: 15px; color: var(--text); }

  /* HERO */
  .hero {
    position: relative;
    padding: 148px 0 96px;
    text-align: center;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute; top: -80px; left: 50%; transform: translateX(-50%);
    width: 720px; height: 620px;
    background: radial-gradient(ellipse at center, rgba(99,102,241,0.16), transparent 65%);
    pointer-events: none; z-index: 0;
  }
  .hero-badge {
    display: inline-block;
    font-family: 'Secular One', system-ui, sans-serif;
    font-size: 13px; font-weight: 400; letter-spacing: 0;
    color: var(--indigo-hi);
    background: var(--indigo-low);
    border: 1px solid var(--border-bright);
    padding: 7px 18px; border-radius: 100px;
    margin-bottom: 28px;
    position: relative; z-index: 1;
  }
  .hero-title {
    font-size: clamp(34px, 6.5vw, 76px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.5px;
    margin-bottom: 22px;
    position: relative; z-index: 1;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--indigo-hi), var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-sub {
    font-size: clamp(15px, 2.2vw, 17px);
    font-weight: 300;
    color: var(--text-dim);
    max-width: 580px;
    margin: 0 auto 38px;
    line-height: 1.8;
    position: relative; z-index: 1;
  }

  /* BUTTONS */
  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none;
    font-size: 15px; font-weight: 600;
    color: #fff;
    background: var(--indigo);
    padding: 14px 34px;
    border-radius: 4px;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 0 28px var(--indigo-glow);
    position: relative; z-index: 1;
  }
  .btn-primary:hover {
    background: var(--indigo-hi);
    transform: translateY(-2px);
    box-shadow: 0 6px 36px var(--indigo-glow);
  }

  /* SECTIONS */
  .section { padding: 84px 0; position: relative; z-index: 1; }
  .section-label {
    font-family: 'Rubik', system-ui, sans-serif;
    font-size: 15px; font-weight: 500;
    letter-spacing: 0;
    color: var(--indigo-hi);
    margin-bottom: 44px;
    text-align: center;
  }
  .section-label::after {
    content: '';
    display: block; width: 36px; height: 2px;
    background: var(--indigo);
    margin: 10px auto 0;
    border-radius: 2px;
  }

  /* PAIN POINTS */
  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 36px;
  }
  .pain-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 28px 22px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .pain-card:hover { border-color: var(--border-bright); transform: translateY(-3px); }
  .pain-icon { font-size: 28px; display: block; margin-bottom: 12px; }
  .pain-title { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .pain-card p { font-size: 14px; color: var(--text-dim); line-height: 1.7; }
  .pain-card em { color: var(--text); font-style: normal; font-weight: 500; }
  .pain-cta { text-align: center; font-size: 17px; color: var(--text-dim); }
  .pain-cta strong { color: var(--indigo-hi); }

  /* HOW IT WORKS */
  .how-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .steps-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    max-width: 420px;
    margin: 0 auto;
  }
  .step-item {
    text-align: center;
    padding: 28px 32px;
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .step-number {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 46px; font-weight: 700;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(99,102,241,0.25);
    line-height: 1;
    margin-bottom: 12px;
    letter-spacing: -2px;
  }
  .step-icon-wrap { font-size: 30px; margin-bottom: 12px; }
  .step-title { font-size: 16px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .step-desc { font-size: 13px; color: var(--text-dim); line-height: 1.65; }
  .step-arrow {
    font-size: 20px; color: var(--indigo);
    padding: 6px 0;
    opacity: 0.6;
  }

  /* FEATURES */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px 18px;
    transition: border-color 0.2s, background 0.2s;
  }
  .feature-card:hover { border-color: var(--border-bright); background: var(--surface-2); }
  .feature-icon { font-size: 26px; display: block; margin-bottom: 12px; }
  .feature-card h3 { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .feature-card p { font-size: 12.5px; color: var(--text-dim); line-height: 1.6; }

  /* FORM */
  .form-section { padding-bottom: 100px; }
  .form-card {
    max-width: 500px;
    margin: 0 auto;
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: 12px;
    padding: 40px 36px;
    box-shadow: 0 0 80px rgba(99,102,241,0.07), 0 0 160px rgba(99,102,241,0.03);
  }
  .form-header { text-align: center; margin-bottom: 28px; }
  .form-badge {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 1px;
    color: var(--indigo-hi);
    background: var(--indigo-low);
    border: 1px solid var(--border-bright);
    padding: 5px 14px; border-radius: 100px;
    margin-bottom: 14px;
  }
  .form-title {
    font-size: 26px; font-weight: 700;
    color: var(--text); letter-spacing: -0.5px;
    margin-bottom: 8px;
  }
  .form-subtitle { font-size: 14px; color: var(--text-dim); line-height: 1.6; }

  .signup-form { display: flex; flex-direction: column; gap: 16px; }
  .field-group { display: flex; flex-direction: column; gap: 6px; }
  .field-group label { font-size: 13px; font-weight: 500; color: var(--text-dim); }
  .field-group input {
    background: rgba(5,5,17,0.8);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 12px 14px;
    font-size: 14px;
    font-family: inherit;
    border-radius: 6px;
    outline: none;
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field-group input::placeholder { color: var(--text-muted); }
  .field-group input:focus {
    border-color: var(--indigo);
    box-shadow: 0 0 0 3px var(--indigo-low);
  }

  .btn-submit {
    width: 100%;
    background: var(--indigo);
    color: #fff;
    border: none;
    padding: 14px;
    font-size: 15px; font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 0 24px var(--indigo-glow);
    margin-top: 4px;
  }
  .btn-submit:hover:not(:disabled) {
    background: var(--indigo-hi);
    transform: translateY(-1px);
    box-shadow: 0 4px 28px var(--indigo-glow);
  }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

  .form-fine-print {
    font-size: 11.5px; color: var(--text-muted);
    line-height: 1.55; text-align: center;
  }

  .feedback-msg {
    margin-top: 20px; padding: 14px 18px;
    border-radius: 6px; font-size: 14px;
    line-height: 1.55; text-align: center;
  }
  .feedback-msg.success {
    background: rgba(16,185,129,0.08);
    border: 1px solid rgba(16,185,129,0.25);
    color: #34d399;
  }
  .feedback-msg.info {
    background: rgba(59,130,246,0.08);
    border: 1px solid rgba(59,130,246,0.25);
    color: #60a5fa;
  }
  .feedback-msg.error {
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.25);
    color: #f87171;
  }

  /* FOOTER */
  .page-footer {
    padding: 24px 32px;
    border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    position: relative; z-index: 1;
