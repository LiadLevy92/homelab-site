---
// Landing page — floating sidebar layout
const canonicalURL = 'https://liad-dev.com/';
const title = 'ליעד לוי | הנדסת חשמל, מערכות הספק RF וניהול פרויקטים';
const description = 'האתר האישי של ליעד לוי. סטודנט להנדסת חשמל והתמחות ב-RF, מנהל ומפתח פרויקטים בתחומי ה-DIY, האוטומציות וה-Homelab.';
---
<!doctype html>
<html lang="he" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="ליעד לוי" />
  <meta name="keywords" content="ליעד לוי, Liad Levy, הנדסת חשמל, RF, מערכות הספק, LiFePO4, Homelab, Proxmox, Home Assistant, n8n, DIY, אוטומציות, ישראל, Second Brain" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="ליעד לוי" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:image" content="https://liad-dev.com/og/home.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="ליעד לוי — Personal Hub" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://liad-dev.com/og/home.png" />

  <!-- JSON-LD — Person schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "ליעד לוי",
    "alternateName": "Liad Levy",
    "url": "https://liad-dev.com",
    "sameAs": [
      "https://github.com/LiadLevy92",
      "https://www.linkedin.com/in/liadlevy92/"
    ],
    "jobTitle": "סטודנט להנדסת חשמל, התמחות RF",
    "description": "מנהל ומפתח פרויקטים בתחומי DIY, אוטומציות, Homelab ומערכות הספק"
  }
  </script>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Global cursor glow -->
  <div class="cursor-glow" id="cursorGlow"></div>

  <!-- Desktop Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-top">
      <a href="/" class="brand">
        <span class="brand-icon">⚡</span>
        <span class="brand-text">PERSONAL HUB</span>
      </a>
    </div>

    <nav class="sidebar-nav">
      <span class="nav-label">Pages</span>
      <a href="/homelab" class="nav-item">Homelab</a>
      <a href="/second-brain" class="nav-item">Second Brain</a>
      <span class="nav-item nav-item--dim" aria-disabled="true">
        Web App
        <span class="nav-badge">Soon</span>
      </span>
    </nav>

    <div class="sidebar-bottom">
      <a href="https://github.com/LiadLevy92" class="ext-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/liadlevy92/" class="ext-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </aside>

  <!-- Mobile Top Navbar -->
  <header class="mobile-nav">
    <a href="/" class="brand">
      <span class="brand-icon">⚡</span>
      <span class="brand-text">PERSONAL HUB</span>
    </a>
    <button class="hamburger" id="hamburger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Mobile Drawer Overlay -->
  <div class="drawer-overlay" id="drawerOverlay"></div>

  <!-- Mobile Drawer -->
  <div class="drawer" id="drawer">
    <nav class="drawer-nav">
      <span class="nav-label">Pages</span>
      <a href="/homelab" class="nav-item">Homelab</a>
      <a href="/second-brain" class="nav-item">Second Brain</a>
      <span class="nav-item nav-item--dim" aria-disabled="true">Web App <span class="nav-badge">Soon</span></span>
      <div class="drawer-divider"></div>
      <a href="https://github.com/LiadLevy92" class="nav-item" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/liadlevy92/" class="nav-item" target="_blank" rel="noopener">LinkedIn ↗</a>
    </nav>
  </div>

  <!-- Main Content -->
  <main class="main">
    <div class="content">

      <div class="intro">
        <span class="hello" id="helloLabel" data-en="About me —" data-he="מי אני —">מי אני —</span>
      </div>

      <h1 class="name">Liad<br>Levy</h1>

      <p class="tagline" lang="en">Electrical Engineering Student (RF Track) · Israel</p>

      <!-- ── Language toggle ─────────────────── -->
      <div class="lang-toggle" role="group" aria-label="שפה / Language">
        <button type="button" class="lang-btn active" data-lang="he" aria-pressed="true">עברית</button>
        <button type="button" class="lang-btn" data-lang="en" aria-pressed="false">English</button>
      </div>

      <!-- ── English bio ─────────────────────── -->
      <div class="bio" id="bioEn" lang="en" style="display:none">
        <p>Hi, I'm Liad Levy.</p>

        <p>I believe the best way to get to know someone is to see what they do in their spare time. I built this site as a place to document what I do — in my own way, at eye level.</p>

        <p>During the day I'm an Electrical Engineering student specializing in RF at SCE, a father of two, and a reserve combat soldier. At night, I run my own projects.</p>

        <p>If you look at the code here or in my apps, you'll see things like Next.js, Supabase, Docker, or Proxmox. But honestly? I'm an Electrical Engineering student 😅 — and that's exactly the point. You don't need to be a classic programmer or sysadmin anymore. You just need to know what you want to build and how to manage the process.</p>

        <p>AI is a ridiculously powerful tool. It instantly shows you the full picture — from initial spec to a working product (well, sort of lol). But without proper guidance, creativity, and critical thinking, it's like Thor's hammer in Spider-Man's hands.</p>

        <p>Here you can check out what Claude built under my direction 😉, alongside physical projects — power supplies and energy stations (LiFePO4), enclosure design in Fusion 360, and automations running in my Homelab.</p>
      </div>

      <!-- ── Hebrew bio ──────────────────────── -->
      <div class="bio bio-rtl" id="bioHe" lang="he">
        <p>היי, אני ליעד לוי.</p>

        <p>אני מאמין שהדרך הכי טובה להכיר בן אדם היא לראות מה הוא עושה בשעות הפנאי שלו. כחלק מהפרויקטים שלי בניתי את האתר הזה, פשוט כדי שיהיה מקום שמתעד את העשייה שלי בגובה העיניים ובדרך שלי.</p>

        <p>ביום-יום אני סטודנט להנדסת חשמל עם התמחות ב-RF ב-SCE, אבא לשניים ולוחם במילואים. בלילה, אני מנהל ומפיק את הפרויקטים שלי.</p>

        <p>אם תסתכלו על הקוד כאן או באפליקציות שלי, תראו מושגים כמו Next.js, סופאבייס, דוקר או פרוקסמוקס. אבל האמת? אני בכלל סטודנט להנדסת חשמל 😅 וזה כל היופי – היום כבר לא חייבים להיות מתכנתים או אנשי סיסטם קלאסיים. כל מה שצריך זה לדעת מה אתה רוצה להשיג ואיך לנהל את זה נכון.</p>

        <p>ה-AI הוא כלי חזק בטירוף, הוא ברגע נותן לנו לראות את התמונה המלאה: מהאפיון הראשוני ועד למוצר עובד (כביכול חח), אבל בלי הדרכה מתאימה, יצירתיות וחשיבה ביקורתית הוא כמו הפטיש של תור בידיים של ספיידרמן.</p>

        <p>פה באתר תוכלו להתרשם ממה שעל הדרך קלוד בנה בהדרכתי 😉, לצד פרויקטים פיזיים של ספקי כוח ותחנות אנרגיה (LiFePO4), תכנון מארזים ב-Fusion 360, ואוטומציות שרצות אצלי ב-Homelab.</p>
      </div>

      <!-- Contact Section -->
      <div class="contact-section">
        <p class="contact-heading">
          <span id="contactHeading" data-en="Looking to hire?" data-he="מחפשים עובד?">מחפשים עובד?</span>
        </p>
        <p class="contact-body" id="contactBodyEn" lang="en" style="display:none">If you've seen the projects and like the way I think — I'd love to send over my CV.</p>
        <p class="contact-body contact-body-he" id="contactBodyHe" lang="he">אם הגעתם לכאן, ראיתם את הפרויקטים שלי ומתחברים לראש הזה – אשמח לשלוח קורות חיים.</p>
        <div class="contact-wrap">
          <button class="contact-btn" id="contactBtn" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <span id="contactBtnLabel" data-en="Get in touch" data-he="צרו איתי קשר">צרו איתי קשר</span>
            <svg class="chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </button>
          <div class="contact-dropdown" id="contactDropdown" aria-hidden="true">
            <a
              id="gmailLink"
              href="#"
              target="_blank"
              rel="noopener"
              class="contact-option"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path fill="#EA4335" d="M6 18V9.5L12 13l6-3.5V18H6z"/>
                <path fill="#FBBC04" d="M6 9.5 0 6v12l6-4.5V9.5z"/>
                <path fill="#34A853" d="M18 9.5V18l6-4.5V6l-6 3.5z"/>
                <path fill="#4285F4" d="m0 6 12 7 12-7-12-7L0 6z"/>
              </svg>
              <span id="gmailLabel" data-en="Open in Gmail" data-he="פתח ב-Gmail">פתח ב-Gmail</span>
            </a>
            <button class="contact-option" id="copyEmailBtn">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <span id="copyLabel" data-en="Copy email address" data-he="העתק כתובת מייל">העתק כתובת מייל</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </main>

  <script is:inline>
    // ─── Drawer ────────────────────────────
    const hamburger = document.getElementById('hamburger');
    const drawer = document.getElementById('drawer');
    const overlay = document.getElementById('drawerOverlay');

    function openDrawer() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    hamburger.addEventListener('click', () => {
      drawer.classList.contains('open') ? closeDrawer() : openDrawer();
    });

    overlay.addEventListener('click', closeDrawer);

    document.querySelectorAll('.drawer-nav .nav-item').forEach(link => {
      if (link.href) link.addEventListener('click', closeDrawer);
    });

    // ─── Language toggle (About me + Contact) ────────
    let currentLang = 'he';
    const langBtns = document.querySelectorAll('.lang-btn');
    const bioEn = document.getElementById('bioEn');
    const bioHe = document.getElementById('bioHe');
    const contactBodyEn = document.getElementById('contactBodyEn');
    const contactBodyHe = document.getElementById('contactBodyHe');
    const helloLabel = document.getElementById('helloLabel');
    const contactHeading = document.getElementById('contactHeading');
    const contactBtnLabel = document.getElementById('contactBtnLabel');
    const gmailLabel = document.getElementById('gmailLabel');
    function txt(el) { if (el) el.textContent = currentLang === 'he' ? el.dataset.he : el.dataset.en; }
    function setLang(lang) {
      currentLang = lang;
      const isHe = lang === 'he';
      if (bioHe) bioHe.style.display = isHe ? '' : 'none';
      if (bioEn) bioEn.style.display = isHe ? 'none' : '';
      if (contactBodyHe) contactBodyHe.style.display = isHe ? '' : 'none';
      if (contactBodyEn) contactBodyEn.style.display = isHe ? 'none' : '';
      txt(helloLabel); txt(contactHeading); txt(contactBtnLabel); txt(gmailLabel);
      txt(document.getElementById('copyLabel'));
      if (contactHeading) contactHeading.dir = isHe ? 'rtl' : 'ltr';
      document.querySelectorAll('.contact-btn, .contact-option').forEach(e => { e.dir = isHe ? 'rtl' : 'ltr'; });
      langBtns.forEach(b => {
        const on = b.dataset.lang === lang;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', String(on));
      });
    }
    langBtns.forEach(b => b.addEventListener('click', () => setLang(b.dataset.lang)));

    // ─── Cursor glows ──────────────────────
    const glow = document.getElementById('cursorGlow');
    document.addEventListener('mousemove', e => {
      glow.style.setProperty('--cx', `${e.clientX}px`);
      glow.style.setProperty('--cy', `${e.clientY}px`);
    });
    document.addEventListener('mouseleave', () => {
      glow.style.setProperty('--cx', '-9999px');
      glow.style.setProperty('--cy', '-9999px');
    });

    document.querySelectorAll('.nav-item, .ext-link').forEach(el => {
      el.addEventListener('mousemove', e => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
        el.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
      });
      el.addEventListener('mouseleave', () => {
        el.style.setProperty('--mouse-x', '-9999px');
        el.style.setProperty('--mouse-y', '-9999px');
      });
    });

    // ─── Contact dropdown ──────────────────
    const contactBtn = document.getElementById('contactBtn');
    const contactDropdown = document.getElementById('contactDropdown');

    contactBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = contactDropdown.classList.contains('open');
      contactDropdown.classList.toggle('open', !isOpen);
      contactBtn.setAttribute('aria-expanded', String(!isOpen));
      contactDropdown.setAttribute('aria-hidden', String(isOpen));
    });

    document.addEventListener('click', () => {
      contactDropdown.classList.remove('open');
      contactBtn.setAttribute('aria-expanded', 'false');
      contactDropdown.setAttribute('aria-hidden', 'true');
    });

    contactDropdown.addEventListener('click', e => e.stopPropagation());

    // ─── Email (assembled at runtime — keeps the plaintext out of static HTML) ──
    const emailAddr = ['liad1023', 'gmail.com'].join('@');
    const gmailLink = document.getElementById('gmailLink');
    const composeSubject = 'היי ליעד — ראיתי את הפרויקטים';
    gmailLink.href = 'https://mail.google.com/mail/?view=cm&to=' +
      encodeURIComponent(emailAddr) + '&subject=' + encodeURIComponent(composeSubject);

    // ─── Copy email ────────────────────────
    document.getElementById('copyEmailBtn').addEventListener('click', () => {
      navigator.clipboard.writeText(emailAddr).then(() => {
        const label = document.getElementById('copyLabel');
        label.textContent = currentLang === 'he' ? 'הועתק! ✓' : 'Copied! ✓';
        setTimeout(() => { txt(label); }, 2000);
      });
    });
  </script>

</body>
</html>

<style>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background: #0e0f18;
    color: #e8eaf2;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 60% 40%, rgba(255, 181, 71, 0.045), transparent 65%),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgba(120, 100, 200, 0.035), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .cursor-glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(
      550px circle at var(--cx, -9999px) var(--cy, -9999px),
      rgba(255, 181, 71, 0.055),
      transparent 70%
    );
    transition: background 0.08s ease;
  }

  /* ─── SIDEBAR ──────────────────────────────── */

  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 240px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    z-index: 100;
  }

  .sidebar-top {
    margin-bottom: 44px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-icon {
    font-size: 15px;
  }

  .brand-text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    color: #c8cad8;
    text-transform: uppercase;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 2px;
  }

  .nav-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 1.5px;
    color: #565d75;
    text-transform: uppercase;
    padding: 0 10px;
    margin-bottom: 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 400;
    color: #969cb0;
    padding: 7px 10px;
    border-radius: 6px;
    transition: background-color 0.15s, color 0.15s;
    cursor: pointer;
    background-image: radial-gradient(
      200px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px),
      rgba(255, 181, 71, 0.08),
      transparent 80%
    );
  }

  .nav-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #e8eaf2;
  }

  .nav-item--dim {
    opacity: 0.35;
    pointer-events: none;
  }

  .nav-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.5px;
    color: #ffb547;
    background: rgba(255, 181, 71, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: auto;
  }

  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding-top: 16px;
    padding-bottom: 12px;
    border-top: 1px solid #181b28;
  }

  .ext-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #8b91a4;
