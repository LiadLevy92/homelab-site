---
// Landing page — floating sidebar layout
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Liad Levy — Electrical Engineering student, homelab builder, dad of two. Personal hub." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Liad Levy — Personal Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Desktop Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-top">
      <a href="/" class="brand">
        <span class="brand-icon">⚡</span>
        <span class="brand-text">PERSONAL HUB</span>
      </a>
    </div>

    <nav class="sidebar-nav">
      <span class="nav-label">Pages</span>
      <a href="/homelab" class="nav-item">Homelab</a>
      <a href="/second-brain" class="nav-item">Second Brain</a>
      <a class="nav-item nav-item--dim">
        Web App
        <span class="nav-badge">Soon</span>
      </a>
    </nav>

    <div class="sidebar-bottom">
      <a href="https://github.com/LiadLevy92" class="ext-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <a href="https://www.linkedin.com/in/liadlevy92/" class="ext-link" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </aside>

  <!-- Mobile Top Navbar -->
  <header class="mobile-nav">
    <a href="/" class="brand">
      <span class="brand-icon">⚡</span>
      <span class="brand-text">PERSONAL HUB</span>
    </a>
    <button class="hamburger" id="hamburger" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Mobile Drawer Overlay -->
  <div class="drawer-overlay" id="drawerOverlay"></div>

  <!-- Mobile Drawer -->
  <div class="drawer" id="drawer">
    <nav class="drawer-nav">
      <span class="nav-label">Pages</span>
      <a href="/homelab" class="nav-item">Homelab</a>
      <a href="/second-brain" class="nav-item">Second Brain</a>
      <a class="nav-item nav-item--dim">Web App <span class="nav-badge">Soon</span></a>
      <div class="drawer-divider"></div>
      <a href="https://github.com/LiadLevy92" class="nav-item" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/liadlevy92/" class="nav-item" target="_blank" rel="noopener">LinkedIn ↗</a>
    </nav>
  </div>

  <!-- Main Content -->
  <main class="main">
    <div class="content">

      <div class="intro">
        <span class="hello">About me —</span>
      </div>

      <h1 class="name">Liad<br>Levy</h1>

      <p class="tagline">Electrical Engineering Student (RF Track) · Israel</p>

      <div class="bio">
        <p>Hey there! I'm an Electrical Engineering student and a lifelong tinkerer. For as long as I can remember, I've been obsessed with figuring out how things work and solving problems using technology.</p>
        <p>The real turning point happened when I rescued an old PC from the street. It was the perfect playground I needed to unleash that curiosity.</p>
        <p>In today's AI era, everything clicked. Instead of spending months mastering every single domain from scratch, I leverage AI to instantly bridge the gap for any task at hand. It has become my ultimate force multiplier — allowing me to jump straight into action, write custom code, and deploy complex tools one late-night session at a time.</p>
        <p>In fact, it's exactly how I built this entire personal hub, mapped out my homelab blueprints, and developed the web application you can access right here on this site.</p>
        <p class="bio-footer">Dad of two. Permanently curious. Learning by doing.</p>
      </div>

    </div>
  </main>

  <script is:inline>
    const hamburger = document.getElementById('hamburger');
    const drawer = document.getElementById('drawer');
    const overlay = document.getElementById('drawerOverlay');

    function openDrawer() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    hamburger.addEventListener('click', () => {
      drawer.classList.contains('open') ? closeDrawer() : openDrawer();
    });

    overlay.addEventListener('click', closeDrawer);

    document.querySelectorAll('.drawer-nav .nav-item').forEach(link => {
      if (link.href) link.addEventListener('click', closeDrawer);
    });

    // Spotlight cursor glow
    document.querySelectorAll('.nav-item, .ext-link').forEach(el => {
      el.addEventListener('mousemove', e => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
        el.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
      });
      el.addEventListener('mouseleave', () => {
        el.style.setProperty('--mouse-x', '-9999px');
        el.style.setProperty('--mouse-y', '-9999px');
      });
    });
  </script>

</body>
</html>

<style>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background: #0e0f18;
    color: #e8eaf2;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 60% at 60% 40%, rgba(255, 181, 71, 0.045), transparent 65%),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgba(120, 100, 200, 0.035), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  /* ─── SIDEBAR ──────────────────────────────── */

  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 240px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    z-index: 100;
  }

  .sidebar-top {
    margin-bottom: 44px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-icon {
    font-size: 15px;
  }

  .brand-text {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    color: #c8cad8;
    text-transform: uppercase;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 2px;
  }

  .nav-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 1.5px;
    color: #2e3348;
    text-transform: uppercase;
    padding: 0 10px;
    margin-bottom: 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 400;
    color: #7c8296;
    padding: 7px 10px;
    border-radius: 6px;
    transition: background-color 0.15s, color 0.15s;
    cursor: pointer;
    background-image: radial-gradient(
      200px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px),
      rgba(255, 181, 71, 0.08),
      transparent 80%
    );
  }

  .nav-item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #e8eaf2;
  }

  .nav-item--dim {
    opacity: 0.35;
    pointer-events: none;
  }

  .nav-badge {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.5px;
    color: #ffb547;
    background: rgba(255, 181, 71, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: auto;
  }

  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding-top: 16px;
    padding-bottom: 12px;
    border-top: 1px solid #181b28;
  }

  .ext-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #5a6070;
    text-decoration: none;
    padding: 7px 10px;
    border-radius: 6px;
    letter-spacing: 0.5px;
    transition: color 0.15s, background-color 0.15s;
    background-image: radial-gradient(
      200px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px),
      rgba(255, 181, 71, 0.08),
      transparent 80%
    );
  }

  .ext-link:hover {
    color: #c8cad8;
    background-color: rgba(255, 255, 255, 0.05);
  }

  /* ─── MOBILE NAV ────────────────────────────── */

  .mobile-nav {
    display: none;
  }

  .hamburger {
    display: none;
  }

  /* ─── DRAWER ────────────────────────────────── */

  .drawer-overlay {
    display: none;
  }

  .drawer {
    display: none;
  }

  /* ─── MAIN CONTENT ──────────────────────────── */

  .main {
    margin-left: 240px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 80px 6vw 80px 5vw;
    position: relative;
    z-index: 1;
  }

  .content {
    width: 100%;
    max-width: 660px;
  }

  .intro {
    margin-bottom: 20px;
  }

  .hello {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 2px;
    color: #ffb547;
    text-transform: uppercase;
  }

  .name {
    font-size: clamp(60px, 9vw, 120px);
    font-weight: 300;
    letter-spacing: -3px;
    line-height: 0.92;
    color: #f0f1f8;
    margin-bottom: 28px;
  }

  .tagline {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: #6b7280;
    letter-spacing: 1px;
    margin-bottom: 36px;
  }

  .bio {
    font-size: 16px;
    font-weight: 300;
    color: #9ba3b5;
    line-height: 1.85;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bio-footer {
    color: #4b5163;
    font-style: italic;
  }

  /* ─── MOBILE ────────────────────────────────── */

  @media (max-width: 768px) {

    .sidebar {
      display: none;
    }

    .mobile-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 200;
      background: rgba(14, 15, 24, 0.95);
      border-bottom: 1px solid #181b28;
      backdrop-filter: blur(8px);
    }

    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
    }

    .hamburger span {
      display: block;
      width: 20px;
      height: 1.5px;
      background: #6b7280;
      transition: background 0.2s;
      border-radius: 1px;
    }

    .hamburger:hover span {
      background: #e8eaf2;
    }

    .drawer-overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 250;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s;
    }

    .drawer-overlay.open {
      opacity: 1;
      pointer-events: all;
    }

    .drawer {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 260px;
      background: #0e0f18;
      border-right: 1px solid #181b28;
      padding: 28px 16px;
      z-index: 300;
      transform: translateX(-100%);
      transition: transform 0.28s ease;
    }

    .drawer.open {
      transform: translateX(0);
    }

    .drawer-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-top: 8px;
    }

    .drawer-divider {
      height: 1px;
      background: #181b28;
      margin: 10px 0;
    }

    .main {
      margin-left: 0;
      padding: 96px 24px 60px;
      align-items: flex-start;
    }

    .name {
      letter-spacing: -2px;
    }
  }
</style>
